# Variables de Entorno para Vercel
# Copia estas variables en la configuración de tu proyecto en Vercel

# Resend API Configuration
RESEND_API_KEY=tu_api_key_de_resend
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAILS=email1@intercert.com,email2@intercert.com

# HubSpot API Configuration
HUBSPOT_ACCESS_TOKEN=tu_access_token_de_hubspot
HUBSPOT_CLIENT_ID=tu_client_id
HUBSPOT_PORTAL_ID=tu_portal_id

# Google Sheets API Configuration (Opcional)
GOOGLE_SHEETS_ID=tu_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu_email_de_servicio
GOOGLE_PRIVATE_KEY=tu_private_key

